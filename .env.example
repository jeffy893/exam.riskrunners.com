# =============================================================================
# exam.riskrunners.com — generator configuration (EXAMPLE / REFERENCE ONLY)
# =============================================================================
# Copy this file to ".env" and adjust as needed:
#
#     cp .env.example .env
#
# The real ".env" is git-ignored and is NEVER committed. This example file
# contains NO secrets and is safe to commit.
#
# IMPORTANT: This project does NOT store AWS credentials here. AWS auth uses the
# standard credential chain (environment variables, ~/.aws/credentials,
# ~/.aws/config profiles, SSO, or an instance role). Configure those with
# `aws configure` or your usual method. This file only selects WHICH region and
# model to use for Bedrock, plus the default generation source.
# -----------------------------------------------------------------------------

# AWS region that has your Bedrock model access enabled.
AWS_REGION=us-west-2

# Bedrock model id. Use a cross-region inference profile id (note the "us."
# prefix) for on-demand Claude access.
#   Examples:
#     us.anthropic.claude-sonnet-4-5-20250929-v1:0   (higher quality, default)
#     us.anthropic.claude-haiku-4-5-20251001-v1:0    (faster / cheaper)
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Default problem source when none is passed on the command line:
#   auto     - author with Bedrock, fall back to templates on any failure (default)
#   bedrock  - Bedrock only; fail if unavailable
#   template - offline deterministic templates only (no AWS needed)
EXAM_SOURCE=auto

# -----------------------------------------------------------------------------
# If you prefer to point at a specific AWS profile instead of the default,
# you can uncomment the following (it selects a profile from ~/.aws; it is NOT
# a secret and does not embed keys):
# AWS_PROFILE=default
